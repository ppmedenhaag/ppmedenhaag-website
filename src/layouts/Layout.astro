---
import "@fontsource-variable/inter";
import globalCss from "../styles/global.css?url";
import Navbar from "../components/Navbar.astro";
import PageBackground from "../components/PageBackground.astro";
import Footer from "../components/footer.astro";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import Seo from "../components/Seo.astro";
import { defaultLocale, type LangOptions } from "../data/i18n";
import { OG_HEIGHT, OG_LOCALE, OG_WIDTH, PRODUCTION_ORIGIN, SITE_NAME, STATIC_COPY, EYEBROW } from "../data/seo";
import { alternatesFor, getSeoRegistry } from "../utils/seo-registry";
import { buildJsonLd } from "../utils/jsonld";
import { fullTitle, isoInTimeZone } from "../utils/seo";
import { useTranslations } from "../utils/lang";

export interface Props {
  /** Page title. Optional: code-driven pages get theirs (localized) from the SEO registry. */
  title?: string;
  /** Overrides the description from the SEO registry. */
  description?: string;
  /** Include this page in the site search index (Pagefind). Off for the homepage and listing pages. */
  searchable?: boolean;
  /** Publish date (posts) or event date (events): shown in search results and used to sort them. */
  date?: Date;
  /** Search engines: keep this page out of the index (404). */
  noindex?: boolean;
}

const { title: titleProp, description: descriptionProp, searchable = true, date, noindex = false } = Astro.props;

// ---- SEO: everything below comes from the page registry (src/utils/seo-registry.ts) ----------------------
const reg = await getSeoRegistry();
const page = reg.byPath.get(Astro.url.pathname);
const seoLocale = (Astro.currentLocale ?? defaultLocale) as LangOptions;
const origin = (Astro.site ?? new URL("https://website-v2.ppmedenhaag.nl")).origin;
const abs = (p: string) => new URL(p, origin).href;
const rawTitle = titleProp ?? page?.title ?? SITE_NAME;
const seoTitle = fullTitle(page?.docTitle ?? rawTitle, SITE_NAME);
const seoDescription = descriptionProp ?? page?.description ?? STATIC_COPY.home[seoLocale].description;
const canonical = abs(Astro.url.pathname);
// Language of the text itself (differs from the URL locale for a few Indonesian pages under /nl/ and /en/).
const textLang = (page?.contentLang ?? seoLocale) as LangOptions;
const cardPath = page?.cardPath ?? reg.byRoute.get(`${seoLocale}|`)!.cardPath;
const image = { url: abs(cardPath), width: OG_WIDTH, height: OG_HEIGHT, alt: rawTitle, type: "image/jpeg" };
const altList = page && !noindex ? alternatesFor(reg, page) : [];
const alternates: { hreflang: string; href: string }[] = altList.map((a) => ({ hreflang: a.locale, href: abs(a.path) }));
if (alternates.length) {
  const nl = altList.find((a) => a.locale === defaultLocale);
  alternates.push({ hreflang: "x-default", href: abs((nl ?? altList.find((a) => a.path === Astro.url.pathname) ?? altList[0]).path) });
}
const isEntry = !!page && ["event", "blog", "ibadah", "about", "dakwah"].includes(page.kind);
// An upcoming event's `date` is the event date, not a publish date: never emit a future article:published_time
// (scripts/sitemap-split.mjs turns it into <lastmod>, and search engines distrust future lastmod values).
const buildTime = Date.now();
const rssPrefix = seoLocale === defaultLocale ? "" : `/${seoLocale}`;
const jsonLd = buildJsonLd({ origin, url: canonical, page, locale: seoLocale, title: rawTitle, description: seoDescription, image });
const isoDate = date ? date.toISOString().slice(0, 10) : undefined;
const currentLocale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(currentLocale as LangOptions);
// Simple Analytics (the Hugo site's privacy-friendly, cookieless analytics): production build only, so staging
// (website-v2 / workers.dev) traffic never reaches the stats. sa-verify = the account's domain-verification token.
const analytics = origin === PRODUCTION_ORIGIN;

// Search facet: first path segment without the locale prefix (event, blog, ibadah, ...).
const segments = Astro.url.pathname.split("/").filter(Boolean);
if (segments[0] === currentLocale && currentLocale !== defaultLocale) segments.shift();
const section = segments[0] ?? "page";
---

<!doctype html>
<html lang={textLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={seoTitle}
      description={seoDescription}
      canonical={canonical}
      noindex={noindex}
      ogType={isEntry ? "article" : "website"}
      siteName={SITE_NAME}
      ogLocale={OG_LOCALE[textLang]}
      ogLocaleAlternates={altList.filter((a) => a.locale !== textLang).map((a) => OG_LOCALE[a.locale])}
      image={image}
      alternates={alternates}
      published={isEntry && page?.date && page.date.valueOf() <= buildTime ? isoInTimeZone(page.date) : undefined}
      section={isEntry && page ? EYEBROW[page.section]?.[seoLocale] : undefined}
      tags={isEntry ? page?.tags : undefined}
      rss={{ title: `${SITE_NAME} (${seoLocale})`, href: abs(`${rssPrefix}/index.xml`) }}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content="#034ea2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={globalCss} />
    <meta name="generator" content={Astro.generator} />
    {analytics && <meta name="sa-verify" content="ssnppmedenhaarr" />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 bg-white px-4 py-2 text-sm font-semibold text-brand-dark shadow-md focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >{t("common.skip")}</a
    >
    <Navbar />
    <div class="app-backdrop relative flex-1">
      <PageBackground />
      <main
        id="main"
        tabindex="-1"
        class="relative focus:outline-none"
        data-pagefind-body={searchable ? "" : undefined}
        data-pagefind-filter={searchable ? "section[data-section], lang[data-lang]" : undefined}
        data-pagefind-sort={searchable && isoDate ? "date[data-date]" : undefined}
        data-pagefind-meta={searchable && isoDate ? "date[data-date]" : undefined}
        data-date={isoDate}
        data-section={section}
        data-lang={currentLocale}
      >
        <slot />
      </main>
    </div>
    <Footer />
    {
      analytics && (
        <>
          <script is:inline async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
          <noscript>
            <img src="https://queue.simpleanalyticscdn.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade" />
          </noscript>
        </>
      )
    }
  </body>
</html>

<script>
  // Copy buttons: <button data-copy="text" data-copied="Copied"><span data-copy-label>Copy</span></button> (IBAN, page link).
  // Feedback for 2 s: the visible label (if any) changes, `data-done` is set (icon-only buttons swap icons with
  // group-data-[done]:...), and an optional [data-copy-status] live region announces it to screen readers.
  document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = Object.assign(document.createElement("textarea"), { value: text });
        ta.style.cssText = "position:fixed;opacity:0";
        document.body.append(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      btn.dataset.done = "";
      const status = btn.querySelector<HTMLElement>("[data-copy-status]");
      if (status) status.textContent = btn.dataset.copied ?? "";
      const label = btn.querySelector<HTMLElement>("[data-copy-label]");
      const original = label ? (label.dataset.original ?? label.textContent ?? "") : "";
      if (label && btn.dataset.copied) {
        label.dataset.original = original;
        label.textContent = btn.dataset.copied;
      }
      clearTimeout(Number(btn.dataset.timer));
      btn.dataset.timer = String(
        setTimeout(() => {
          delete btn.dataset.done;
          if (status) status.textContent = "";
          if (label) label.textContent = original;
        }, 2000),
      );
    });
  });
  // Native share sheet (phones): revealed only where the Web Share API exists.
  if (typeof navigator.share === "function") {
    document.querySelectorAll<HTMLElement>("[data-share]").forEach((btn) => {
      btn.hidden = false;
      btn.addEventListener("click", () => {
        navigator.share({ title: btn.dataset.title, url: btn.dataset.url }).catch(() => {});
      });
    });
  }
  // Time-limited UI (e.g. "add to calendar" once the event is over), in case the page was built before that moment.
  document.querySelectorAll<HTMLElement>("[data-expires]").forEach((el) => {
    if (Date.now() > Date.parse(el.dataset.expires ?? "")) el.remove();
  });
  // Its counterpart: content rendered `hidden` that appears once the ISO time has passed (the CTA image after the homepage video's `until`).
  document.querySelectorAll<HTMLElement>("[data-reveals-at]").forEach((el) => {
    if (Date.now() > Date.parse(el.dataset.revealsAt ?? "")) el.hidden = false;
  });

  // Homepage video (components/HomepageVideo.astro): the poster link becomes the youtube-nocookie player on click.
  // Ctrl/Cmd/Shift/middle clicks keep the link's normal behaviour (open YouTube in a new tab/window).
  document.querySelectorAll<HTMLElement>("[data-youtube]").forEach((box) => {
    const link = box.querySelector<HTMLAnchorElement>("a");
    link?.addEventListener("click", (e) => {
      if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.youtube ?? "")}?autoplay=1&rel=0`;
      iframe.title = box.dataset.youtubeTitle ?? "YouTube";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.className = "absolute inset-0 size-full border-0";
      link.replaceWith(iframe);
      iframe.focus();
    });
  });

  // Wide tables in Markdown content (schedules, cost tables) scroll inside the article instead of widening the page on
  // phones. Tables that already sit in a scrolling wrapper (overflow-x-auto in the Markdown) are left alone.
  document.querySelectorAll<HTMLTableElement>(".prose table").forEach((table) => {
    const parent = table.parentElement;
    if (!parent || /(auto|scroll)/.test(getComputedStyle(parent).overflowX)) return;
    const wrap = document.createElement("div");
    wrap.className = "table-scroll";
    parent.insertBefore(wrap, table);
    wrap.append(table);
  });

  // Accordion for Markdown content: <div class="accordion-trigger" data-accordion-trigger data-accordion-target="#id" data-accordion-group="#group">.
  document
    .querySelectorAll<HTMLElement>("[data-accordion-trigger]")
    .forEach((trigger) => {
      trigger.setAttribute("role", "button");
      trigger.tabIndex = 0;
      trigger.setAttribute("aria-expanded", "false");
      const toggle = () => {
        const target = document.querySelector<HTMLElement>(
          trigger.dataset.accordionTarget ?? "",
        );
        if (!target) return;
        const open = !target.classList.contains("is-open");
        if (open && trigger.dataset.accordionGroup) {
          document
            .querySelectorAll<HTMLElement>(
              `${trigger.dataset.accordionGroup} .accordion-panel.is-open`,
            )
            .forEach((el) => {
              el.classList.remove("is-open");
              document
                .querySelector(`[data-accordion-target="#${el.id}"]`)
                ?.setAttribute("aria-expanded", "false");
            });
        }
        target.classList.toggle("is-open", open);
        trigger.setAttribute("aria-expanded", String(open));
      };
      trigger.addEventListener("click", toggle);
      trigger.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });
</script>
