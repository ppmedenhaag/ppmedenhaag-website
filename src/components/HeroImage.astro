---
// Page hero image: real width/height (prevents layout shift), WebP srcset, LCP-friendly loading hints.
import Img from "./Img.astro";

interface Props {
  /** public/-relative path as in front matter, e.g. images/events/x.webp */
  src: string;
  alt: string;
  class?: string;
  /** `sizes` preset of Img.astro. */
  sizes?: "hero" | "side";
  /** Above the fold (LCP candidate): eager + high fetch priority. */
  eager?: boolean;
}
const { src, alt, class: className, sizes = "hero", eager = true } = Astro.props;
---

<Img src={src} alt={alt} class={className} sizes={sizes} loading={eager ? "eager" : "lazy"} />
