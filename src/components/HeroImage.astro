---
// Page hero image: real width/height (prevents layout shift), WebP srcset, LCP-friendly loading hints.
import Img from "./Img.astro";

interface Props {
  /** public/-relative path as in front matter, e.g. images/events/x.webp */
  src: string;
  alt: string;
  class?: string;
  /** Above the fold (LCP candidate): eager + high fetch priority. */
  eager?: boolean;
}
const { src, alt, class: className, eager = true } = Astro.props;
---

<Img src={src} alt={alt} class={className} sizes="hero" loading={eager ? "eager" : "lazy"} />
