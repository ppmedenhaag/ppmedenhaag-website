---
import Layout from "../layouts/Layout.astro";
import Pagination from "./Pagination.astro";
import PostCard from "./PostCard.astro";
import type { LangOptions } from "../data/i18n";
import { getLocalePosts } from "../utils/blog";
import { useTranslations } from "../utils/lang";

interface Props {
  locale: LangOptions;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getLocalePosts(locale);
---

<Layout searchable={false}>
  <div class="section">
    <h1
      class="page-title title-rule mb-10"
    >
      {t("blog.title")}
    </h1>
    <div id="paged-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
    <Pagination locale={locale} target="#paged-list" />
  </div>
</Layout>
