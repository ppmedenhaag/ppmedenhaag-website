---
import Layout from "../layouts/Layout.astro";
import Pagination from "./Pagination.astro";
import EventCard from "./EventCard.astro";
import type { LangOptions } from "../data/i18n";
import { getLocaleEvents } from "../utils/event";
import { useTranslations } from "../utils/lang";

interface Props {
  locale: LangOptions;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const events = await getLocaleEvents(locale);
---

<Layout title={t("event.title")} searchable={false}>
  <div class="section">
    <h1
      class="page-title title-rule mb-10"
    >
      {t("event.title")}
    </h1>
    <div id="paged-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {events.map((event) => <EventCard event={event} locale={locale} />)}
    </div>
    <Pagination locale={locale} target="#paged-list" />
  </div>
</Layout>
