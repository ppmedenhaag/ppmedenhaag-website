---
import { Image } from "astro:assets";
import { getLang, useTranslations } from "../utils/lang";
import contactImage from "../assets/contact.webp";
import { SubjectData } from "../data/contact";
const locale = getLang(Astro.url);
const t = useTranslations(locale);
const subjects = SubjectData[locale];
---

<form action="https://formspree.io/f/mdknakbg" method="POST">
  <div class="space-y-12">
    <div class="border-b border-gray-900/10 pb-12">
      <h2
        class="text-2xl md:text-3xl font-bold text-ppme-blue-800 border-b-4 py-1 border-red-600 max-w-fit"
      >
        {t("contact.title")}
      </h2>
      <p class="mt-1 text-sm leading-6 text-ppme-blue-700">
        {t("contact.subtitle")}
      </p>
      <Image
        src={contactImage}
        alt="Contact"
        class="rounded-xl my-4"
        widths={[240, 540, 720, contactImage.width]}
        sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${contactImage.width}px`}
      />
      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-4">
          <label
            for="subject"
            class="block text-sm font-medium leading-6 text-ppme-blue-800"
            >{t("contact.subject")}</label
          >
          <select
            id="subject"
            name="subject"
            class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6"
          >
            {subjects.map((s) => <option>{s.text}</option>)}
          </select>
        </div>
        <div class="sm:col-span-4">
          <label
            for="name"
            class="block text-sm font-medium leading-6 text-ppme-blue-800"
            >{t("contact.name")}</label
          >
          <div class="mt-2">
            <div
              class="flex rounded-md shadow-sm ring-1 ring-inset ring-ppme-blue-400 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-600 sm:max-w-md"
            >
              <input
                type="text"
                name="name"
                id="name"
                autocomplete="name"
                class="block flex-1 border-0 bg-transparent py-1.5 pl-1 text-ppme-blue-800 placeholder:text-ppme-blue-500 focus:ring-0 sm:text-sm sm:leading-6"
              />
            </div>
          </div>
        </div>

        <div class="sm:col-span-4">
          <label
            for="email"
            class="block text-sm font-medium leading-6 text-ppme-blue-800"
            >{t("contact.email")}</label
          >
          <div class="mt-2">
            <div
              class="flex rounded-md shadow-sm ring-1 ring-inset ring-ppme-blue-400 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-600 sm:max-w-md"
            >
              <input
                type="email"
                name="email"
                id="email"
                autocomplete="email"
                class="block flex-1 border-0 bg-transparent py-1.5 pl-1 text-ppme-blue-800 placeholder:text-ppme-blue-500 focus:ring-0 sm:text-sm sm:leading-6"
              />
            </div>
          </div>
        </div>

        <div class="col-span-full">
          <label
            for="message"
            class="block text-sm font-medium leading-6 text-ppme-blue-800"
            >{t("contact.message")}</label
          >
          <div class="mt-2">
            <textarea
              id="message"
              name="message"
              rows="4"
              class="block w-full rounded-md border-0 py-1.5 text-ppme-blue-800 shadow-sm ring-1 ring-inset ring-ppme-blue-400 placeholder:text-ppme-blue-500 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
            ></textarea>
          </div>
          <!-- <p class="mt-3 text-sm leading-6 text-ppme-blue-700">
            ....
          </p> -->
        </div>

        <button
          type="submit"
          class="rounded-md bg-ppme-blue-700 px-3 py-2 text-sm font-semibold text-ppme-blue-50 shadow-sm hover:bg-ppme-blue-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ppme-blue-700"
          >{t("contact.send")}</button
        >
      </div>
    </div>
  </div>
</form>
