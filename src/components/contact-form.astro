---
import { Image } from "astro:assets";
import { useTranslations } from "../utils/lang";
import contactImage from "../assets/contact.webp";
import ContactSubject from "./react/ContactSubject";
import { Icon } from "astro-icon/components";
import { defaultLocale, type LangOptions } from "../data/i18n";
import { CONTACT, VENUE_MAPS_URL } from "../data/site";
import { SOCIAL_LINKS } from "../data/seo";

const locale = (Astro.currentLocale ?? defaultLocale) as LangOptions;
const t = useTranslations(locale);
---

<div class="mx-auto max-w-3xl lg:grid lg:max-w-none lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start lg:gap-6">
<form
  action={CONTACT.formAction}
  method="POST"
  class="min-w-0"
>
  <div class="animate-fade-up border border-slate-200 bg-white p-6 sm:p-10">
    <h1 class="page-title title-rule">{t("contact.title")}</h1>
    <p class="mt-5 max-w-prose text-base leading-relaxed text-slate-600">
      {t("contact.subtitle")}
    </p>
    <Image
      src={contactImage}
      alt="Contact"
      class="my-8 w-full border border-slate-200"
      widths={[240, 540, 720, 760, contactImage.width]}
      sizes="(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1023px) 688px, 760px"
    />
    <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
      {/* Honeypot: Formspree drops submissions that fill this hidden field (bots). */}
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <div class="sm:col-span-2">
        <ContactSubject client:load locale={locale} label={t("contact.subject")} />
      </div>
      <div>
        <label for="name" class="field-label">{t("contact.name")}</label>
        <input
          type="text"
          name="name"
          id="name"
          autocomplete="name"
          class="field"
        />
      </div>
      <div>
        <label for="email" class="field-label">{t("contact.email")}</label>
        <input
          type="email"
          name="email"
          id="email"
          autocomplete="email"
          class="field"
        />
      </div>
      <div class="sm:col-span-2">
        <label for="message" class="field-label">{t("contact.message")}</label>
        <textarea id="message" name="message" rows="5" class="field"></textarea>
      </div>
      <div class="sm:col-span-2">
        <button type="submit" class="btn btn-lg btn-primary shine">
          {t("contact.send")}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-4"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</form>

<section class="mt-6 border border-slate-200 bg-white p-6 sm:p-8 lg:sticky lg:top-24 lg:mt-0" aria-labelledby="contact-direct">
  <h2 id="contact-direct" class="eyebrow">{t("contact.direct")}</h2>
  <dl class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-3 lg:grid-cols-1">
    <div class="flex items-start gap-3">
      <Icon name="heroicons:envelope" class="mt-0.5 size-5 shrink-0 text-brand" aria-hidden="true" />
      <div class="min-w-0">
        <dt class="text-xs font-semibold text-slate-500">{t("contact.emailUs")}</dt>
        <dd class="mt-0.5"><a href={`mailto:${CONTACT.email}`} class="font-semibold break-all text-brand hover:text-brand-dark">{CONTACT.email}</a></dd>
      </div>
    </div>
    <div class="flex items-start gap-3">
      <Icon name="heroicons:map-pin" class="mt-0.5 size-5 shrink-0 text-brand" aria-hidden="true" />
      <div>
        <dt class="text-xs font-semibold text-slate-500">{t("contact.visit")}</dt>
        <dd class="mt-0.5 text-sm leading-relaxed text-slate-800">
          {CONTACT.address.name}<br />{CONTACT.address.street}<br />{CONTACT.address.postalCode} {CONTACT.address.city}
        </dd>
        <dd class="mt-1">
          <a href={VENUE_MAPS_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs font-semibold text-brand hover:text-brand-dark">
            {t("contact.directions")}
            <Icon name="heroicons:arrow-top-right-on-square" class="size-3.5" aria-hidden="true" />
          </a>
        </dd>
      </div>
    </div>
    <div class="flex items-start gap-3">
      <Icon name="heroicons:chat-bubble-left-right" class="mt-0.5 size-5 shrink-0 text-brand" aria-hidden="true" />
      <div>
        <dt class="text-xs font-semibold text-slate-500">Social media</dt>
        <dd class="mt-0.5 flex flex-col gap-0.5 text-sm">
          {SOCIAL_LINKS.map((l) => (
            <a href={l} target="_blank" rel="noopener" class="font-medium text-slate-800 hover:text-brand">{new URL(l).hostname.replace(/^www\./, "").split(".")[0].replace(/^./, (c) => c.toUpperCase()).replace("Youtube", "YouTube")}</a>
          ))}
        </dd>
      </div>
    </div>
  </dl>
</section>
</div>
