---
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { PUBLIC_BACKGROUND } from "astro:env/client";
import { useTranslations } from "../utils/lang";
import EventCard from "./EventCard.astro";
import PostCard from "./PostCard.astro";
import PrayerTimes from "./PrayerTimes.astro";
import type { LangOptions } from "../data/i18n";

interface Props {
  locale: LangOptions;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const homepageEntry = await getEntry(`homepage-${locale}`, "homepage");
if (!homepageEntry) {
  throw new Error(`Missing homepage entry for locale "${locale}"`);
}
const home = homepageEntry.data;

const events = (
  await getCollection("event", ({ id, data }) => {
    return id.startsWith(`${locale}/`) && !data.draft;
  })
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (
  await getCollection("blog", ({ id, data }) => {
    return id.startsWith(`${locale}/`) && !data.draft;
  })
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

{
  home.prayer_times.enable && (
    <section class="mx-auto max-w-3xl px-0 pt-0.5 sm:px-4 sm:pt-4">
      <PrayerTimes locale={locale} />
    </section>
  )
}

{
  home.about.enable && (
    <section class="section pt-6! pb-16! md:pt-3! md:pb-16!">
      <div class="mx-auto max-w-3xl lg:max-w-5xl">
        <div class="animate-fade-up border border-slate-200 bg-white p-6 backdrop-blur-lg md:p-6 lg:p-6">
          <h1 class="page-title title-rule">{home.about.title}</h1>
          <p class="mt-4 text-base leading-relaxed whitespace-pre-line text-slate-600 md:text-lg md:mt-4">
            {home.about.content}
          </p>
          <div class="mt-4 grid grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-3">
            <a
              href={getRelativeLocaleUrl(locale, "ibadah/islamitisch-trouwen/")}
              class="btn btn-lg btn-primary w-full"
            >
              {t("homepage.nikah")}
            </a>
            <a
              href={getRelativeLocaleUrl(locale, "ibadah/toetreden-islam/")}
              class="btn btn-lg btn-secondary w-full"
            >
              {t("homepage.shahada")}
            </a>
          </div>
          {home.event.enable && events.length > 0 && (
            <a
              href="#events"
              class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-dark"
            >
              {t("homepage.checkEvents")}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-4"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"
                />
              </svg>
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

{
  home.cta.enable && (
    <section class="relative isolate overflow-hidden bg-brand-darker py-8 md:py-10">
      <div
        class="pointer-events-none absolute -top-32 -left-24 -z-10 size-[26rem] rounded-full bg-brand-400/40 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute -right-24 -bottom-32 -z-10 size-[26rem] rounded-full bg-brand/60 blur-3xl"
        aria-hidden="true"
      />
      {PUBLIC_BACKGROUND === "pattern" && (
        <div
          class="app-grid app-grid-light pointer-events-none absolute inset-0 -z-10"
          aria-hidden="true"
        />
      )}
      <div class="reveal mx-auto grid max-w-3xl grid-cols-1 justify-items-center gap-3 px-4 text-center">
        <span class="text-[clamp(0.875rem,4.4vw,1.25rem)] font-semibold tracking-wide whitespace-nowrap text-brand-100 uppercase">{home.cta.subtitle}</span>
        <span class="text-2xl font-bold tracking-tight text-white lg:text-4xl">
          {home.cta.title}
        </span>
        {home.cta.img.enable && (
          <img
            class="mt-2 w-full max-w-xl border border-white/20"
            src={home.cta.img.src}
            alt={home.cta.img.desc}
          />
        )}
        {home.cta.button.enable && (
          <a
            href={getRelativeLocaleUrl(locale, home.cta.button.link)}
            class="btn btn-lg btn-inverse shine mt-4 min-w-40"
          >
            {home.cta.button.label}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        )}
      </div>
    </section>
  )
}

{
  home.shodaqoh?.enable && (
    <section class="border-y border-brand-100 bg-brand-50/70">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-3 px-4 py-5 text-center sm:flex-row sm:justify-between sm:text-left">
        <span class="font-semibold text-brand-darker">
          {home.shodaqoh.title}
        </span>
        <a
          href="https://www.ing.nl/de-ing/payreq?trxid=pGFVuaic76PdDsKuFNeHD4wkJ5edNwsY"
          class="btn btn-sm btn-primary"
        >
          PPME Den Haag
          <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
        </a>
      </div>
    </section>
  )
}

{
  home.event.enable && events.length > 0 && (
    <section id="events" class="scroll-mt-20 border-t border-slate-200 bg-white/60">
      <div class="section">
        <div class="mb-8 flex items-end justify-between gap-4">
          <h2 class="title-rule section-heading">
            {home.event.title}
          </h2>
          <a
            href={getRelativeLocaleUrl(locale, "event/")}
            class="btn btn-sm btn-secondary hidden sm:inline-flex"
          >
            {t("homepage.seeAll")}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {events.map((event) => (
            <EventCard event={event} locale={locale} />
          ))}
        </div>
        <div class="mt-8 text-center sm:hidden">
          <a
            href={getRelativeLocaleUrl(locale, "event/")}
            class="btn btn-sm btn-secondary"
          >
            {t("homepage.seeAll")}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        </div>
      </div>
    </section>
  )
}

{
  home.blog.enable && posts.length > 0 && (
    <section class="section">
      <div class="mb-8 flex items-end justify-between gap-4">
        <h2 class="title-rule section-heading">
          {home.blog.title}
        </h2>
        <a
          href={getRelativeLocaleUrl(locale, "blog/")}
          class="btn btn-sm btn-secondary hidden sm:inline-flex"
        >
          {t("homepage.seeAll")}
          <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} locale={locale} />
        ))}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a
          href={getRelativeLocaleUrl(locale, "blog/")}
          class="btn btn-sm btn-secondary"
        >
          {t("homepage.seeAll")}
          <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-4"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
              />
            </svg>
        </a>
      </div>
    </section>
  )
}
