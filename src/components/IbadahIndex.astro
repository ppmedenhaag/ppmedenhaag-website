---
// /ibadah/ (+ /id/, /en/): section index that exists on the live Hugo site (it was missing here, a URL-parity gap).
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import type { LangOptions } from "../data/i18n";
import { STATIC_COPY, PRAYER_COPY } from "../data/seo";
import { LATEST_YEAR, fill, prayerStrings } from "../data/prayer";
import { getSeoRegistry } from "../utils/seo-registry";
import { useTranslations } from "../utils/lang";

interface Props {
  locale: LangOptions;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = STATIC_COPY.ibadah[locale];
const order = ["toetreden-islam", "islamitisch-trouwen", "geboorte", "overlijden", "sadaqah"];
const { pages } = await getSeoRegistry();
const items = pages
  .filter((p) => p.locale === locale && p.kind === "ibadah")
  .sort((a, b) => {
    const ia = order.indexOf(a.routeKey.split("/")[1]);
    const ib = order.indexOf(b.routeKey.split("/")[1]);
    return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
  });
const prayer = pages.find((p) => p.locale === locale && p.routeKey === "ibadah/gebedstijden");
---

<Layout searchable={false}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 class="page-title title-rule mb-6">{copy.title}</h1>
    <p class="mb-10 max-w-3xl text-lg leading-relaxed text-slate-600">{copy.description}</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((p) => (
          <article class="tile group reveal">
            {p.data?.image && (
              <a href={p.path} class="tile-media" tabindex="-1" aria-hidden="true">
                <img src={`/${p.data.image}`} alt="" loading="lazy" />
              </a>
            )}
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h2>
                <a href={p.path} class="tile-title tile-title-link">{p.title}</a>
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 line-clamp-3">{p.description}</p>
              <span class="tile-link mt-5">
                {t("common.readMore")}
                <span class="arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </article>
        ))
      }
      {
        prayer && (
          <article class="tile group reveal">
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h2>
                <a href={getRelativeLocaleUrl(locale, "ibadah/gebedstijden/")} class="tile-title tile-title-link">
                  {fill(prayerStrings[locale].pageTitle, { year: LATEST_YEAR })}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 line-clamp-3">{PRAYER_COPY[locale].description}</p>
              <span class="tile-link mt-5">
                {t("common.readMore")}
                <span class="arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </article>
        )
      }
    </div>
  </div>
</Layout>
