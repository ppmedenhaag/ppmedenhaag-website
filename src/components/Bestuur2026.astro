---
// Story page of the 2026 board (/bestuur-2026/, /id/..., /en/...). Mobile first: the photos swap sides down the page,
// on desktop they get their own column and the text sits beside them. Copy and facts: src/data/bestuur.ts.
import { getRelativeLocaleUrl } from "astro:i18n";
import Img from "./Img.astro";
import type { LangOptions } from "../data/i18n";
import { BESTUUR_COPY, BESTUUR_GROUP_IMAGE, BESTUUR_STAIRS_IMAGE, BOARD, type BoardMember } from "../data/bestuur";

interface Props {
  locale: LangOptions;
}
const { locale } = Astro.props;
const copy = BESTUUR_COPY[locale];

// Chapter 1 = the first three board members, chapter 2 = the treasurers. Side = global index parity.
const chapters = [BOARD.slice(0, 3), BOARD.slice(3)].map((members, c) => ({
  ...copy.chapters[c],
  members: members.map((m) => ({ m, side: (BOARD.indexOf(m) % 2 === 0 ? "left" : "right") as "left" | "right" })),
}));

const placement = (side: "left" | "right") =>
  side === "left"
    ? {
        grid: "grid-cols-[8.5rem_1fr] sm:grid-cols-[11rem_1fr]",
        photo: "md:col-start-1 md:col-span-5",
        text: "md:col-start-6 md:col-span-7",
        head: "",
        frame: "before:translate-x-2 before:translate-y-2",
      }
    : {
        grid: "grid-cols-[1fr_8.5rem] sm:grid-cols-[1fr_11rem]",
        photo: "col-start-2 md:col-start-8 md:col-span-5",
        text: "md:col-start-1 md:col-span-7",
        head: "text-right md:text-left",
        frame: "before:-translate-x-2 before:translate-y-2",
      };

const t = (m: BoardMember) => ({
  role: m.role[locale],
  food: m.food[locale],
  hobby: m.hobby[locale],
  quote: m.quote[locale],
});
---

<div class="bs overflow-x-clip">
  <!-- Hero -->
  <header class="page-wrap grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-16">
    <div class="lg:col-span-5">
      <p class="eyebrow mb-3">{copy.eyebrow}</p>
      <h1 class="page-title title-rule">{copy.title}</h1>
      <p class="mt-6 text-2xl font-semibold tracking-tight text-brand-dark sm:text-3xl">{copy.lead}</p>
      <p class="mt-4 max-w-prose text-base leading-relaxed text-slate-700 sm:text-lg">{copy.intro}</p>
    </div>
    <figure class="bs-hero relative lg:col-span-7">
      <div class="relative before:absolute before:inset-0 before:translate-x-2 before:translate-y-2 before:border before:border-brand-200 before:content-['']">
        <Img
          src={BESTUUR_GROUP_IMAGE}
          alt={copy.heroAlt}
          sizes="half"
          loading="eager"
          class="relative block h-auto w-full border border-slate-200 bg-brand-50"
        />
      </div>
    </figure>
  </header>

  <!-- Numbers -->
  <section class="page-wrap !pt-0" aria-label={copy.title}>
    <dl class="grid grid-cols-3 divide-x divide-slate-200 border border-slate-200 bg-white/90">
      {
        copy.stats.map((s) => (
          <div class="px-3 py-5 text-center sm:px-6 sm:py-7">
            <dt class="text-3xl font-extrabold tracking-tight text-brand sm:text-5xl">{s.value}</dt>
            <dd class="mt-1 text-xs leading-snug text-slate-600 sm:text-sm">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    chapters.map((chapter, c) => (
      <>
        <section class="page-wrap">
          <div class="mb-10 md:mb-14">
            <p class="eyebrow">{String(c + 1).padStart(2, "0")}</p>
            <h2 class="section-heading title-rule mt-1">{chapter.title}</h2>
            <p class="mt-3 text-slate-600">{chapter.text}</p>
          </div>

          <div class="space-y-14 md:space-y-24">
            {chapter.members.map(({ m, side }) => {
              const p = placement(side);
              const x = t(m);
              return (
                <article
                  class:list={["bs-person grid gap-x-5 gap-y-6 md:grid-cols-12 md:content-center md:gap-x-10", p.grid]}
                  data-side={side}
                  id={m.slug}
                >
                  <figure
                    class:list={[
                      "bs-photo relative row-start-1 self-center md:row-span-2 md:self-auto",
                      p.photo,
                    ]}
                  >
                    <div
                      class:list={[
                        "relative before:absolute before:inset-0 before:border before:border-brand-200 before:content-[''] md:max-w-sm",
                        side === "left" ? "md:mr-auto" : "md:ml-auto",
                        p.frame,
                      ]}
                    >
                      <button
                        type="button"
                        class="bs-zoom relative block w-full cursor-zoom-in md:pointer-events-none md:cursor-default"
                        data-src={`/${m.image}`}
                        data-name={`${m.name}, ${x.role}`}
                        aria-label={`${copy.zoom.open}: ${m.name}`}
                      >
                        <Img
                          src={m.image}
                          alt={m.name}
                          sizes="card"
                          class="relative block aspect-square w-full border border-slate-200 bg-brand-50 object-cover"
                        />
                        <span
                          class="absolute right-1.5 bottom-1.5 flex size-7 items-center justify-center bg-white/90 text-brand-dark md:hidden"
                          aria-hidden="true"
                        >
                          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4M8.5 6v5M6 8.5h5"/></svg>
                        </span>
                      </button>
                    </div>
                  </figure>

                  <div
                    class:list={[
                      "bs-text row-start-1 flex min-w-0 flex-col justify-center md:row-start-1 md:self-end",
                      side === "left" ? "col-start-2" : "col-start-1",
                      p.text,
                      p.head,
                    ]}
                  >
                    <p class="eyebrow">{x.role}</p>
                    <h3 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl md:text-4xl">
                      {m.name}
                    </h3>
                  </div>

                  <div class:list={["bs-text col-span-2 min-w-0 md:row-start-2 md:self-start", p.text]}>
                    <dl class="grid grid-cols-[6.25rem_1fr] gap-x-4 gap-y-3 border-t border-slate-200 pt-4 text-sm sm:grid-cols-[8rem_1fr] sm:text-base md:mt-1">
                      <dt class="eyebrow pt-1">{copy.labels.born}</dt>
                      <dd class="text-slate-800">{m.born}</dd>
                      <dt class="eyebrow pt-1">{copy.labels.food}</dt>
                      <dd class="text-slate-800">{x.food}</dd>
                      <dt class="eyebrow pt-1">{copy.labels.hobby}</dt>
                      <dd class="text-slate-800">{x.hobby}</dd>
                    </dl>

                    <figure class="mt-6">
                      <figcaption class="eyebrow mb-2">{copy.labels.quote}</figcaption>
                      <blockquote
                        class="bs-quote relative border-l-2 border-brand bg-brand-50/60 py-3 pr-4 pl-5 text-base leading-relaxed text-slate-800 sm:text-lg"
                        lang={locale}
                      >
                        {x.quote}
                      </blockquote>
                    </figure>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        {c === 0 && (
          <section class="page-wrap">
            <figure class="bs-interlude relative lg:pb-12">
              <Img
                src={BESTUUR_STAIRS_IMAGE}
                alt={copy.stairsAlt}
                sizes="wide"
                class="block h-auto w-full border border-slate-200 bg-brand-50"
              />
              <figcaption
                class="relative border border-t-0 border-slate-200 bg-white p-5 sm:p-7 lg:absolute lg:right-8 lg:bottom-0 lg:max-w-md lg:border-t"
              >
                <p class="text-xl font-bold tracking-tight text-brand-darker sm:text-2xl">“{copy.interlude.quote}”</p>
                <p class="eyebrow mt-3">{copy.interlude.by}</p>
              </figcaption>
            </figure>
          </section>
        )}
      </>
    ))
  }

  <!-- Closing -->
  <section class="page-wrap">
    <div class="relative isolate overflow-hidden bg-brand-darker px-6 py-12 text-center sm:px-12 md:py-16">
      <div class="pointer-events-none absolute -top-24 right-0 -z-10 size-80 rounded-full bg-brand/50 blur-3xl" aria-hidden="true"></div>
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{copy.closing.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-brand-100 sm:text-lg">{copy.closing.text}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={getRelativeLocaleUrl(locale, "about/about-1/")}
          class="btn bg-white text-brand-darker hover:bg-brand-50">{copy.closing.join}</a
        >
        <a
          href={getRelativeLocaleUrl(locale, "contact/")}
          class="btn border border-brand-300 text-white hover:bg-white/10">{copy.closing.contact}</a
        >
      </div>
    </div>
    {copy.translationNote && <p class="mt-6 text-center text-xs text-slate-500">{copy.translationNote}</p>}
  </section>
</div>

<!-- Phone photo zoom: tap a portrait to see it large, tap anywhere / Esc to close. -->
<dialog id="bs-lightbox" class="bs-lightbox" aria-label={copy.title}>
  <form method="dialog" class="m-0 flex size-full flex-col items-center justify-center gap-4 p-4">
    <img id="bs-lightbox-img" alt="" class="max-h-[78vh] max-w-full border border-white/20 object-contain" />
    <p id="bs-lightbox-cap" class="text-center text-sm font-semibold text-white"></p>
    <button class="btn border border-white/40 text-white" aria-label={copy.zoom.close}>{copy.zoom.close}</button>
  </form>
</dialog>

<script>
  const box = document.getElementById("bs-lightbox") as HTMLDialogElement | null;
  const big = document.getElementById("bs-lightbox-img") as HTMLImageElement | null;
  const cap = document.getElementById("bs-lightbox-cap");
  const phone = window.matchMedia("(max-width: 767px)");
  document.querySelectorAll<HTMLButtonElement>(".bs-zoom").forEach((b) => {
    b.addEventListener("click", () => {
      if (!box || !big || !cap || !phone.matches) return;
      big.src = b.dataset.src ?? "";
      big.alt = b.dataset.name ?? "";
      cap.textContent = b.dataset.name ?? "";
      box.showModal();
      document.documentElement.style.overflow = "hidden";
    });
  });
  box?.addEventListener("click", () => box.close());
  box?.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
  });
</script>

<style>
  /* Photos drift in from their own side, text rises, as each block scrolls into view. Progressive enhancement:
     browsers without scroll-driven animations (and reduced-motion users) just see the static layout. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bs-photo,
      .bs-text,
      .bs-interlude,
      .bs-hero {
        animation-fill-mode: both;
        animation-timing-function: ease-out;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
      .bs-person[data-side="left"] .bs-photo {
        animation-name: bs-from-left;
      }
      .bs-person[data-side="right"] .bs-photo {
        animation-name: bs-from-right;
      }
      .bs-text {
        animation-name: bs-rise;
      }
      .bs-interlude {
        animation-name: bs-rise;
      }
      .bs-hero {
        animation-name: bs-from-right;
        animation-range: entry 0% entry 80%;
      }
    }
  }
  @keyframes bs-from-left {
    from {
      opacity: 0;
      transform: translateX(-2.5rem);
    }
  }
  @keyframes bs-from-right {
    from {
      opacity: 0;
      transform: translateX(2.5rem);
    }
  }
  @keyframes bs-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  .bs-lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(1 28 59 / 0.94);
  }
  .bs-lightbox::backdrop {
    background: transparent;
  }
  .bs-lightbox:not([open]) {
    display: none;
  }
  @media (min-width: 768px) {
    .bs-lightbox {
      display: none !important;
    }
  }
</style>
