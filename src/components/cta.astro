---
import { getLocale } from "astro-i18n-aut";
import { Image } from "astro:assets";
import { CTA_CONFIG } from "../data/config";
import { UI_CONFIG } from "../data/ui";
import { getLang, useTranslations } from "../utils/lang";
const locale = getLang(Astro.url);
const t = useTranslations(locale);
---

{
  UI_CONFIG.showCTA && (
    <div class="py-4 mx-auto grid grid-cols-1  justify-items-center bg-ppme-blue-700 space-y-1">
      <span class="text-xl lg:text-3xl font-semibold text-ppme-blue-200">
        {CTA_CONFIG.get(locale)?.subtitle}
      </span>
      <span class="text-2xl lg:text-5xl font-bold text-ppme-blue-100">
        {CTA_CONFIG.get(locale)?.title}
      </span>
      {CTA_CONFIG.get(locale)?.image && (
        <Image
          src={CTA_CONFIG.get(locale)?.image ?? "/images/default.webp"}
          alt="CTA"
          width={800}
          height={600}
          class="px-1 py-2 lg:py-3"
        />
      )}
      <a
        href="#"
        class="rounded-md min-w-36 text-center bg-ppme-blue-100 px-3 py-2 text-base font-semibold text-ppme-blue-800 shadow-sm hover:bg-ppme-blue-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ppme-blue-100"
      >
        {t("cta.button")}
      </a>
    </div>
  )
}
