---
import { getLocale } from "astro-i18n-aut";
import { Image } from 'astro:assets';
import { CTA_CONFIG } from "../data/config";
const locale = getLocale(Astro.url);
const currentPath = `/${new URL(Astro.url).pathname}`;

---
<div class="py-4 mx-auto grid grid-cols-1 border-2 justify-items-center bg-ppme-blue-700 space-y-2">
    <span class="text-3xl font-semibold text-ppme-blue-200">{CTA_CONFIG.get(locale)?.subtitle }</span>
    <span class="text-5xl font-bold text-ppme-blue-100">{CTA_CONFIG.get(locale)?.title }</span>
    <Image src={CTA_CONFIG.get(locale)?.image } alt="CTA" width={800} height={600} class="rounded-md"/>

</div>