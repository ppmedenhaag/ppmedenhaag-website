---
const navigation = {
  solutions: [
    { name: "Marketing", href: "#" },
    { name: "Analytics", href: "#" },
    { name: "Commerce", href: "#" },
    { name: "Insights", href: "#" },
  ],
  support: [
    { name: "Pricing", href: "#" },
    { name: "Documentation", href: "#" },
    { name: "Guides", href: "#" },
    { name: "API Status", href: "#" },
  ],
  company: [
    { name: "About", href: "#" },
    { name: "Blog", href: "#" },
    { name: "Jobs", href: "#" },
    { name: "Press", href: "#" },
    { name: "Partners", href: "#" },
  ],
  legal: [
    { name: "Claim", href: "#" },
    { name: "Privacy", href: "#" },
    { name: "Terms", href: "#" },
  ],
  social: [
    {
      name: "Facebook",
      href: "#",
      icon: "/icons/fb.svg",
    },
    {
      name: "Instagram",
      href: "#",
      icon: "/icons/ig.svg",
    },


    {
      name: "YouTube",
      href: "#",
      icon: "/icons/yt.svg",
    },
    {
      name: "GitHub",
      href: "#",
      icon: "/icons/gh.svg",
    },    
  ],
};
---

<footer aria-labelledby="footer-heading" class="bg-ppme-blue-50/10">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-4 md:space-y-8">
        <img
          alt="PPME Den Haag"
          src="/ppme-logo.svg"
          class="h-[70px]"
        />
        <div class="px-1 text-base font-semibold text-ppme-blue-700  grid grid-cols-1">
            <span>Heeswijkplein 170</span>
            <span>2531 HK Den Haag</span>
        </div>
        <div class="flex space-x-4 md:space-x-8">
          {
            navigation.social.map((item) => (
              <a href={item.href} class="border border-ppme-blue-50 hover:border-ppme-blue-700 p-1 rounded-md hober:bg-white">
                <span class="sr-only">{item.name}</span>
                <img src={item.icon} class="h-6 w-6 md:h-8 md:w-8" />
              </a>
            ))
          }
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-ppme-blue-900">
              Solutions
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              {
                navigation.solutions.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-sm leading-6 text-ppme-blue-700 hover:text-ppme-blue-900"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-ppme-blue-900">
              Support
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              {
                navigation.support.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-sm leading-6 text-ppme-blue-700 hover:text-ppme-blue-900"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-ppme-blue-900">
              Company
            </h3>
            <ul role="list" class="mt-6 space-y-4">
              {
                navigation.company.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-sm leading-6 text-ppme-blue-700 hover:text-ppme-blue-900"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-ppme-blue-900">Legal</h3>
            <ul role="list" class="mt-6 space-y-4">
              {
                navigation.legal.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-sm leading-6 text-ppme-blue-700 hover:text-ppme-blue-900"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-ppme-blue-900/10 pt-8 sm:mt-20 lg:mt-24">
      <p class="text-xs leading-5 text-ppme-blue-500">
        &copy; 2024, PPME Den Haag.
      </p>
    </div>
  </div>
</footer>
