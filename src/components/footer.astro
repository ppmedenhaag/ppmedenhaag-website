---
import { Icon } from "astro-icon/components";
import { defaultLocale, type LangOptions } from "../data/i18n";
import { CONTACT, DONATION, VENUE_MAPS_URL } from "../data/site";

const headerLinks = {
  activities: { nl: "Activiteiten", id: "Kegiatan", en: "Activities" },
  support: { nl: "Informatie", id: "Informasi", en: "Information" },
};

const navigation = {
  ibadah: {
    nl: [
      { name: "Toetreden tot de Islam", href: "/ibadah/toetreden-islam/" },
      { name: "Islamitisch trouwen", href: "/ibadah/islamitisch-trouwen/" },
      { name: "Geboorte", href: "/ibadah/geboorte/" },
      { name: "Overlijden", href: "/ibadah/overlijden/" },
      { name: "Zakat, Infaq en Sadaqah", href: "/ibadah/sadaqah/" },
    ],
    id: [
      { name: "Mualaf", href: "/id/ibadah/toetreden-islam/" },
      { name: "Pernikahan", href: "/id/ibadah/islamitisch-trouwen/" },
      { name: "Kelahiran", href: "/id/ibadah/geboorte/" },
      { name: "Kematian", href: "/id/ibadah/overlijden/" },
      { name: "Zakat, Infaq dan Sadaqah", href: "/id/ibadah/sadaqah/" },
    ],
    en: [
      { name: "Joining Islam", href: "/en/ibadah/toetreden-islam/" },
      { name: "Marriage", href: "/en/ibadah/islamitisch-trouwen/" },
      { name: "Birth", href: "/en/ibadah/geboorte/" },
      { name: "Passing Away", href: "/en/ibadah/overlijden/" },
      { name: "Zakat, Infaq and Sadaqah", href: "/en/ibadah/sadaqah/" },
      { name: "Prayer Times (Den Haag)", href: "/en/ibadah/gebedstijden/" },
    ],
  },
  support: {
    nl: [
      { name: "Evenementen", href: "/event/" },
      { name: "Blog", href: "/blog/" },
      { name: "Gebedstijden", href: "/ibadah/gebedstijden/" },
      { name: "Contact", href: "/contact/" },
      { name: "Over Ons", href: "/about/" },
    ],
    id: [
      { name: "Event", href: "/id/event/" },
      { name: "Blog", href: "/id/blog/" },
      { name: "Jadwal Sholat", href: "/id/ibadah/gebedstijden/" },
      { name: "Kontak", href: "/id/contact/" },
      { name: "Tentang Kami", href: "/id/about/" },
    ],
    en: [
      { name: "Events", href: "/en/event/" },
      { name: "Blog", href: "/en/blog/" },
      { name: "Prayer Times", href: "/en/ibadah/gebedstijden/" },
      { name: "Contact", href: "/en/contact/" },
      { name: "About Us", href: "/en/about/" },
    ],
  },
  company: [
    { name: "About", href: "#" },
    { name: "Blog", href: "#" },
    { name: "Jobs", href: "#" },
    { name: "Press", href: "#" },
    { name: "Partners", href: "#" },
  ],
  legal: [
    { name: "Claim", href: "#" },
    { name: "Privacy", href: "#" },
    { name: "Terms", href: "#" },
  ],
  social: [
    {
      name: "Facebook",
      href: "https://www.facebook.com/PPMEcabDenHaag/",
      icon: "/icons/fb.svg",
    },
    {
      name: "Instagram",
      href: "https://www.instagram.com/ppme_denhaag/",
      icon: "/icons/ig.svg",
    },

    {
      name: "YouTube",
      href: "https://www.youtube.com/@ppmedenhaag5842",
      icon: "/icons/yt.svg",
    },
    // {
    //   name: "GitHub",
    //   href: "#",
    //   icon: "/icons/gh.svg",
    // },
  ],
};
const locale = (Astro.currentLocale ?? defaultLocale) as LangOptions;
---

<footer
  aria-labelledby="footer-heading"
  class="relative overflow-hidden bg-brand-darker text-brand-100"
>
  <div
    class="pointer-events-none absolute -top-40 -right-40 size-[28rem] rounded-full bg-brand/40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="h-0.5 bg-gradient-to-r from-brand-400 via-brand-200 to-brand-400"></div>
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="relative mx-auto max-w-7xl px-4 pt-12 pb-8 sm:px-6 lg:px-8 lg:pt-16">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-6">
        <a
          href={locale === defaultLocale ? "/" : `/${locale}/`}
          class="inline-block rounded-full bg-white px-6 py-2.5 transition-opacity hover:opacity-90"
        >
          <img alt="PPME Den Haag" src="/images/logo.png" width="135" height="70" class="h-14 w-auto" />
        </a>
        <div class="flex items-start gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="mt-0.5 size-5 shrink-0 text-brand-300"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
            ></path>
          </svg>
          <a href={VENUE_MAPS_URL} target="_blank" rel="noopener" class="grid grid-cols-1 text-sm leading-relaxed font-medium text-white hover:underline">
            <span>{CONTACT.address.name}</span>
            <span>{CONTACT.address.street}</span>
            <span>{CONTACT.address.postalCode} {CONTACT.address.city}</span>
          </a>
        </div>
        <div class="flex items-center gap-3">
          <Icon name="heroicons:envelope" class="size-5 shrink-0 text-brand-300" aria-hidden="true" />
          <a href={`mailto:${CONTACT.email}`} class="text-sm font-medium text-white hover:underline">{CONTACT.email}</a>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="heroicons:banknotes" class="mt-0.5 size-5 shrink-0 text-brand-300" aria-hidden="true" />
          <p class="text-sm leading-relaxed text-brand-100">
            <span class="block font-medium text-white tabular-nums">IBAN {DONATION.iban}</span>
            <span class="block text-xs">{DONATION.holder}</span>
          </p>
        </div>
        <ul role="list" class="flex flex-wrap gap-3">
          {
            navigation.social.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex size-10 items-center justify-center border border-white/20 bg-white/5 transition-all duration-200 hover:-translate-y-0.5 hover:border-white hover:bg-white focus-visible:outline-white"
                >
                  <span class="sr-only">{item.name}</span>
                  <img
                    src={item.icon}
                    alt=""
                    class="size-5 brightness-0 invert transition-[filter] duration-200 group-hover:brightness-100 group-hover:invert-0"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 xl:col-span-2 xl:mt-0">
        <div>
          <h3 class="text-[11px] font-semibold tracking-[0.14em] text-brand-300 uppercase">
            {headerLinks.activities[locale]}
          </h3>
          <ul role="list" class="mt-4 divide-y divide-white/10 border-t border-white/10">
            {
              navigation.ibadah[locale].map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group flex items-center justify-between py-2.5 text-sm font-medium text-brand-100 transition-colors hover:text-white"
                  >
                    {item.name}
                    <span
                      class="text-brand-300 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
                      aria-hidden="true">→</span
                    >
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="text-[11px] font-semibold tracking-[0.14em] text-brand-300 uppercase">
            {headerLinks.support[locale]}
          </h3>
          <ul role="list" class="mt-4 divide-y divide-white/10 border-t border-white/10">
            {
              navigation.support[locale].map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group flex items-center justify-between py-2.5 text-sm font-medium text-brand-100 transition-colors hover:text-white"
                  >
                    {item.name}
                    <span
                      class="text-brand-300 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
                      aria-hidden="true">→</span
                    >
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <div
      class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-brand-200 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} PPME Den Haag</p>
      <p>Masjid Al Hikmah · Den Haag</p>
    </div>
  </div>
</footer>
