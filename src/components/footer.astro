---
import { defaultLocale, type LangOptions } from "../data/i18n";

const headerLinks = {
  activities: { nl: "Activiteiten", id: "Kegiatan", en: "Activities" },
  support: { nl: "Informatie", id: "Informasi", en: "Information" },
};

const navigation = {
  ibadah: {
    nl: [
      { name: "Toetreden tot de Islam", href: "/ibadah/toetreden-islam/" },
      { name: "Islamitisch trouwen", href: "/ibadah/islamitisch-trouwen/" },
      { name: "Geboorte", href: "/ibadah/geboorte/" },
      { name: "Overlijden", href: "/ibadah/overlijden/" },
      { name: "Zakat, Infaq en Sadaqah", href: "/ibadah/sadaqah/" },
    ],
    id: [
      { name: "Mualaf", href: "/id/ibadah/toetreden-islam/" },
      { name: "Pernikahan", href: "/id/ibadah/islamitisch-trouwen/" },
      { name: "Kelahiran", href: "/id/ibadah/geboorte/" },
      { name: "Kematian", href: "/id/ibadah/overlijden/" },
      { name: "Zakat, Infaq dan Sadaqah", href: "/id/ibadah/sadaqah/" },
    ],
    en: [
      { name: "Joining Islam", href: "/en/ibadah/toetreden-islam/" },
      { name: "Marriage", href: "/en/ibadah/islamitisch-trouwen/" },
      { name: "Birth", href: "/en/ibadah/geboorte/" },
      { name: "Passing Away", href: "/en/ibadah/overlijden/" },
      { name: "Zakat, Infaq and Sadaqah", href: "/en/ibadah/sadaqah/" },
      {
        name: "Prayer Schedule 2025 (Den Haag)",
        href: "/forms/schedule-sholat-den-haag-2025.pdf",
      },
    ],
  },
  support: {
    nl: [
      { name: "Evenementen", href: "/event/" },
      { name: "Blog", href: "/blog/" },
      { name: "Gebedstijden", href: "/forms/schedule-sholat-den-haag-2024.pdf" },
      { name: "Contact", href: "/contact/" },
      { name: "Over Ons", href: "/about/" },
    ],
    id: [
      { name: "Event", href: "/id/event/" },
      { name: "Blog", href: "/id/blog/" },
      { name: "Jadwal Sholat", href: "/forms/schedule-sholat-den-haag-2024.pdf" },
      { name: "Kontak", href: "/id/contact/" },
      { name: "Tentang Kami", href: "/id/about/" },
    ],
    en: [
      { name: "Events", href: "/en/event/" },
      { name: "Blog", href: "/en/blog/" },
      { name: "Prayer Schedule", href: "/forms/schedule-sholat-den-haag-2024.pdf" },
      { name: "Contact", href: "/en/contact/" },
      { name: "About Us", href: "/en/about/" },
    ],
  },
  company: [
    { name: "About", href: "#" },
    { name: "Blog", href: "#" },
    { name: "Jobs", href: "#" },
    { name: "Press", href: "#" },
    { name: "Partners", href: "#" },
  ],
  legal: [
    { name: "Claim", href: "#" },
    { name: "Privacy", href: "#" },
    { name: "Terms", href: "#" },
  ],
  social: [
    {
      name: "Facebook",
      href: "https://www.facebook.com/PPMEcabDenHaag/",
      icon: "/icons/fb.svg",
    },
    {
      name: "Instagram",
      href: "https://www.instagram.com/ppme_denhaag/",
      icon: "/icons/ig.svg",
    },

    {
      name: "YouTube",
      href: "#",
      icon: "/icons/yt.svg",
    },
    {
      name: "GitHub",
      href: "#",
      icon: "/icons/gh.svg",
    },
  ],
};
const locale = (Astro.currentLocale ?? defaultLocale) as LangOptions;
---

<footer aria-labelledby="footer-heading" class="bg-ppme-blue-50/10">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-12 sm:pt-24 lg:px-8 lg:pt-16">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-4 md:space-y-8">
        <img alt="PPME Den Haag" src="/ppme-logo.svg" class="h-[70px]" />
        <div class="px-1 flex space-x-2 items-center">
          <img src="/icons/address.svg" class="h-6" />
          <div
            class="text-base font-semibold text-ppme-blue-700 grid grid-cols-1"
          >
            <span>Heeswijkplein 170</span>
            <span>2531 HK Den Haag</span>
          </div>
        </div>
        <div class="flex space-x-4 md:space-x-8">
          {
            navigation.social.map((item) => (
              <a
                href={item.href}
                class="border border-ppme-blue-50 hover:border-ppme-blue-700 p-1 rounded-md hober:bg-white"
              >
                <span class="sr-only">{item.name}</span>
                <img src={item.icon} class="h-6 w-6 md:h-8 md:w-8" />
              </a>
            ))
          }
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-lg font-semibold text-zinc-600">
              {headerLinks.activities[locale]}
            </h3>
            <ul role="list" class="mt-4 space-y-1 md:space-y-3 pl-4 md:pl-0">
              {
                navigation.ibadah[locale].map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-base text-ppme-blue-700 hover:text-ppme-blue-600 font-semibold  hover:underline"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-lg font-semibold text-zinc-600">
              {headerLinks.support[locale]}
            </h3>
            <ul role="list" class="mt-4 space-y-1 md:space-y-3 pl-4 md:pl-0">
              {
                navigation.support[locale].map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-base text-ppme-blue-700 hover:text-ppme-blue-600 font-semibold hover:underline"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
