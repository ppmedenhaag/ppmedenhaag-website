---
import { getLocale } from "astro-i18n-aut";
import {menuData} from "../data/i18n.js"
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png'; 
import {
  Astronav,
  MenuItems,
  MenuIcon,
  Dropdown,
  DropdownItems,
  DropdownSubmenu,
} from "astro-navbar";

const locale = getLocale(Astro.url);
const currentPath = `/${new URL(Astro.url).pathname}`;

---

<header class="lg:flex justify-between px-2 mx-auto container">
  <Astronav closeOnClick>
    <div class="flex w-full lg:w-auto justify-between items-center">
      <!-- <Image src={logoImage} alt="Logo"   
      width="100"
      height="50" /> -->
      <img src="/logo.svg" class="w-24 h-24"> </img>
      <div class="block lg:hidden items-center ">
        <MenuIcon class="w-8 h-8 text-gray-800 m-1 border-2 border-gray-400" />
      </div>
    </div>
    <MenuItems class="hidden lg:flex py-4 px-2">
      <ul
        class="flex flex-col lg:flex-row lg:gap-5 gap-y-2 font-semibold text-indigo-900 lg:items-center"
      >
      {
        menuData.get(locale)?.map(({ text, href, links }) => (
          <li>      
        {links?.length ? (
                  <Dropdown class="group ">
            <button class="flex items-center gap-x-2 ">
              <span> {text}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="3"
                stroke="currentColor"
                class="w-3 h-3 mt-0.5 group-open:rotate-180"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </button>
            <DropdownItems class="relative">
              <div
                class="lg:absolute bg-white top-2 text-nowrap border shadow rounded p-2"
              >
                <ul>
                  {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            ' md:hover:bg-gray-100 hover:text-link hover:bg-gray-200 dark:hover:text-white dark:hover:bg-gray-700 py-1 px-4 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>

                  ))}</ul></div></DropDownItems></Dropdown>
        ):(
          <a href={href}>{text}</a>
        )}
        </li>
        ))}
      </ul>
    </MenuItems>
  </Astronav>
</header>
