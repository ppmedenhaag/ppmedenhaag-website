---
import { getLocale } from "astro-i18n-aut";
import {menuData} from "../data/i18n.js"

import {
  Astronav,
  MenuItems,
  MenuIcon,
  Dropdown,
  DropdownItems,
  DropdownSubmenu,
} from "astro-navbar";

const locale = getLocale(Astro.url);
const currentPath = `/${new URL(Astro.url).pathname}`;

---

<header class="lg:flex justify-between p-5 gap-5 mx-auto container">
  <Astronav closeOnClick>
    <div class="flex w-full lg:w-auto justify-between">
      <a>{locale}</a>
      <div class="block lg:hidden">
        <MenuIcon class="w-4 h-4 text-gray-800" />
      </div>
    </div>
    <MenuItems class="hidden lg:flex">
      <ul
        class="flex flex-col lg:flex-row lg:gap-5 font-semibold text-indigo-900"
      >
      {
        menuData.get(locale)?.map(({ text, href, links }) => (
          <li>      
        {links?.length ? (
                  <Dropdown class="group">
            <button class="flex items-center gap-x-2">
              <span> {text}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="3"
                stroke="currentColor"
                class="w-3 h-3 mt-0.5 group-open:rotate-180"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </button>
            <DropdownItems class="relative">
              <div
                class="lg:absolute bg-white top-2 w-40 border shadow rounded p-2"
              >
                <ul>
                  {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            ' md:hover:bg-gray-100 hover:text-link hover:bg-gray-200 dark:hover:text-white dark:hover:bg-gray-700 py-1 px-4 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>

                  ))}</ul></div></DropDownItems></Dropdown>
):(
          <a href={href}>{text}</a>
        )}
        </li>
        ))}
      </ul>
    </MenuItems>
  </Astronav>
</header>
