---
import { getLocale } from "astro-i18n-aut";
import { menuData } from "../data/i18n.js";
import { Image } from "astro:assets";
import logoImage from "../assets/logo-ppme-denhaag.png";
import {
  Astronav,
  MenuItems,
  MenuIcon,
  Dropdown,
  DropdownItems,
  DropdownSubmenu,
} from "astro-navbar";

const locale = getLocale(Astro.url);
const currentPath = `/${new URL(Astro.url).pathname}`;
const langs = [{text:"NL", href:"#"}, {text:"ID", href:"#"}, {text:"EN", href:"#"}]
---

<header
  class="lg:flex justify-between bg-gradient-to-r from-ppme-blue-50 to-ppme-blue-200 border-b-ppme-blue-700 border-b-4 py-2"
>
  
  <Astronav closeOnClick>
    <div class="flex w-full lg:w-auto justify-between items-center ">
      <Image src={logoImage} alt="Logo" width="120" height="60" />

      <div class="block lg:hidden mr-2">
        <MenuIcon
          class="w-8 h-8 md:w-12 md:h-12 text-ppme-blue-900 m-1 border-ppme-blue-800 border-2 lg:border-4 rounded-md"
        />
      </div>
    </div>



    <MenuItems
      class="hidden flex-grow lg:flex px-2 lg:text-lg font-semibold justify-evenly"
    >
      <ul
        class="flex flex-col lg:flex-row lg:gap-5 gap-y-2 text-ppme-blue-900 lg:items-center"
      >
        {
          menuData.get(locale)?.map(({ text, href, links }) => (
            <li>
              {links?.length ? (
                <Dropdown class="group ">
                  <button class="flex items-center gap-x-2">
                    <span> {text}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="3"
                      stroke="currentColor"
                      class="w-3 h-3 mt-0.5 group-open:rotate-180"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                      />
                    </svg>
                  </button>
                  <DropdownItems class="relative">
                    <div class="lg:absolute bg-white top-2 text-nowrap border shadow rounded p-0.5">
                      <ul>
                        {links.map(({ text: text2, href: href2 }) => (
                          <li>
                            <a
                              class:list={[
                                "hover:bg-ppme-blue-100 hover:text-link border-l-4 border-l-white hover:border-l-ppme-blue-700  py-1 px-4 block whitespace-no-wrap",
                                { "aw-link-active": href2 === currentPath },
                              ]}
                              href={href2}
                            >
                              {text2}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </DropdownItems>
                </Dropdown>
              ) : (
                <a href={href}>{text}</a>
              )}
            </li>
          ))
        }
      </ul>
    </MenuItems>

  </Astronav>

</header>
