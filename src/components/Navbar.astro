---
import NavbarExample from "./react/ReactNavbar";
import { getLang } from "../utils/lang";
import { menuData, defaultLocale } from "../data/i18n";
import { LANG_LIST } from "../data/i18n";

import { getRelativeLocaleUrl } from "astro:i18n";
import { getEntry } from "astro:content";
import type { LangOptions } from "../data/i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as LangOptions;
const currentPath = new URL(Astro.url).pathname;

// Clean current path to get the "route" without locale
// e.g. /en/about -> /about, /about -> /about
let route = currentPath;
if (locale !== defaultLocale && route.startsWith(`/${locale}`)) {
  route = route.slice(locale.length + 1);
}
// Ensure leading slash
if (!route.startsWith("/")) route = "/" + route;

const localMenu = menuData[locale as keyof typeof menuData];

const langLinksPromises = LANG_LIST.map(async (a) => {
  let shouldInclude = true;

  // Configuration mapping route prefixes to content collection names.
  // Add new sections here as they're migrated (about, dakwah, ibadah, ...).
  const contentMap: Record<string, "event" | "blog"> = {
    "/event/": "event",
    "/blog/": "blog",
  };

  for (const [prefix, collectionName] of Object.entries(contentMap)) {
    if (route.startsWith(prefix) && route.length > prefix.length) {
      // Extract slug
      let slug = route.slice(prefix.length);
      if (slug.endsWith("/")) slug = slug.slice(0, -1);

      // Check existence
      try {
        const entry = await getEntry(collectionName, `${a.code}/${slug}`);
        if (!entry) {
          shouldInclude = false;
        }
      } catch (e) {
        shouldInclude = false;
      }
      break; // Found a matching prefix, stop checking
    }
  }

  if (!shouldInclude) return null;

  return {
    name: a.name,
    code: a.code,
    flagUrl: a.flagUrl,
    path: getRelativeLocaleUrl(a.code, route),
  };
});

const langLinks = (await Promise.all(langLinksPromises)).filter(
  (l) => l !== null,
);
---

<NavbarExample
  locale={locale}
  currentPath={currentPath}
  menu={localMenu}
  langLinks={langLinks}
  client:load
/>
