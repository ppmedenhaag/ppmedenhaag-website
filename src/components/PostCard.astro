---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { LangOptions } from "../data/i18n";
import { formatPostDate, postSlug } from "../utils/blog";
import { useTranslations } from "../utils/lang";
import { stripMarkdown, truncateText } from "../utils/text";
import Img from "./Img.astro";

interface Props {
  post: CollectionEntry<"blog">;
  locale: LangOptions;
}
const { post, locale } = Astro.props;
const t = useTranslations(locale);
const href = getRelativeLocaleUrl(locale, `blog/${postSlug(post)}/`);
---

<article class="tile group reveal">
  {
    post.data.image && (
      <a href={href} class="tile-media" tabindex="-1" aria-hidden="true">
        <Img src={post.data.image} alt="" sizes="card" />
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="eyebrow">
      <time datetime={post.data.date.toISOString()}>
        {formatPostDate(post.data.date, locale)}
      </time>
      {post.data.author && <span> · {post.data.author}</span>}
    </p>
    <h2 class="mt-2">
      <a href={href} class="tile-title tile-title-link">{post.data.title}</a>
    </h2>
    <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-slate-600">
      {
        post.data.description ||
          truncateText(stripMarkdown(post.body ?? ""), 100)
      }
    </p>
    <span class="tile-link mt-5">
      {t("common.readMore")}
      <span class="arrow" aria-hidden="true">→</span>
    </span>
  </div>
</article>
