---
// Option 5 background: a faint outline map of the Netherlands with all 12 provinces and Den Haag marked.
// Paths come from src/data/nl-map.ts (generated by scripts/build-nl-map.mjs from PDOK/CBS open data).
import { DEN_HAAG, NL_PROVINCES, NL_VIEWBOX } from "../data/nl-map";

// Covers IJsselmeer + Markermeer + Randmeren in nl-map.ts coordinates (viewBox 295.8 x 348.4).
const LAKES_MASK =
  "M132.2 85.8L155.3 69.8L165.7 88.8L201.2 116.9L190.8 139.1L177.5 153.8L165.7 165.7L153.8 165.7L130.2 159.8L127.2 124.3L130.2 97.6Z";
---

<div class="nl-map" aria-hidden="true">
  <div class="nl-map__stage">
    <svg
      class="nl-map__svg"
      viewBox={`0 0 ${NL_VIEWBOX.width} ${NL_VIEWBOX.height}`}
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        {/* Everything inside the country is masked out, so only the OUTER half of a stroke remains: the country outline (coast, borders, islands), without any inner province borders. */}
        <mask
          id="nl-outside"
          maskUnits="userSpaceOnUse"
          x="-10"
          y="-10"
          width={NL_VIEWBOX.width + 20}
          height={NL_VIEWBOX.height + 20}
        >
          <rect x="-10" y="-10" width={NL_VIEWBOX.width + 20} height={NL_VIEWBOX.height + 20} fill="#fff" />
          {/* The thin black stroke also covers the hairline seams where neighbouring provinces meet (anti-aliasing) - those were showing up as faint province borders. */}
          {NL_PROVINCES.map((p) => <path d={p.d} fill="#000" stroke="#000" stroke-width="0.6" />)}
          {/* IJsselmeer/Markermeer are water cut out of the land data, so their straight dikes and polder edges were drawn as blocky rectangles. This hand-placed polygon (inside the lakes, clear of the Afsluitdijk and the sea) hides them. */}
          <path d={LAKES_MASK} fill="#000" />
        </mask>
      </defs>
      {/* Land: one faint tint for the whole country, Zuid-Holland a little stronger. No strokes here. */}
      {NL_PROVINCES.map((p) => (
        <path class={p.name === "Zuid-Holland" ? "land land--home" : "land"} d={p.d} />
      ))}
      {/* Line work: country outline + Zuid-Holland border. One group, so overlaps do not stack into darker spots. */}
      <g class="lines">
        <g mask="url(#nl-outside)">
          {NL_PROVINCES.map((p) => <path class="coast" d={p.d} />)}
        </g>
        {NL_PROVINCES.filter((p) => p.name === "Zuid-Holland").map((p) => <path class="zh-border" d={p.d} />)}
      </g>
      <g class="marker" transform={`translate(${DEN_HAAG.x} ${DEN_HAAG.y})`}>
        <circle class="marker__pulse" r="3" />
        <circle class="marker__dot" r="2.6" />
        <path class="marker__leader" d="M-3.6 0 H-17" />
        <text class="marker__label" x="-20" y="2.6" text-anchor="end">Den Haag</text>
      </g>
    </svg>
  </div>
</div>

<style>
  /* Sticky viewport-high stage inside a page-high layer: the map stays in view while scrolling
     but never paints over the navbar or footer. */
  .nl-map {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }
  .nl-map__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .nl-map__svg {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Fit the whole map: limited by viewport height (desktop) and by viewport width (phones). Aspect ratio is 295.8 : 348.4. */
    width: min(94vw, 90vh * 0.849, 730px);
    height: auto;
    transform: translate(-50%, -46%);
    overflow: visible;
  }

  .land {
    fill: rgb(3 78 162 / 0.035);
  }
  .land--home {
    fill: rgb(3 78 162 / 0.08);
  }
  /* Opaque strokes + opacity on the group: overlapping lines never get darker. */
  .lines {
    opacity: 0.15;
  }
  .coast {
    fill: none;
    stroke: rgb(3 78 162);
    stroke-width: 1.4; /* clipped to its outer half by the mask, so ~0.7 wide */
    stroke-linejoin: round;
  }
  .zh-border {
    fill: none;
    stroke: rgb(3 78 162);
    stroke-width: 0.7;
    stroke-linejoin: round;
  }

  .marker__dot {
    fill: rgb(3 78 162 / 0.85);
  }
  .marker__pulse {
    fill: rgb(3 78 162 / 0.35);
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 3.6s ease-out infinite;
  }
  .marker__leader {
    stroke: rgb(3 78 162 / 0.45);
    stroke-width: 0.6;
    fill: none;
  }
  .marker__label {
    fill: rgb(3 78 162 / 0.75);
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.6; }
    80%, 100% { transform: scale(4.2); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marker__pulse { animation: none; opacity: 0.25; transform: scale(2.2); }
  }
</style>
