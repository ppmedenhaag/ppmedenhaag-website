---
// Option 5 background: a faint map of the Netherlands (country outline + Zuid-Holland) with Den Haag marked.
// The static artwork is src/assets/nl-map.svg (generated by scripts/build-nl-map-svg.mjs from src/data/nl-map.ts),
// loaded as a hashed, long-cached image so the path data isn't repeated in every page's HTML. Only the animated
// marker is inline: it uses the page font and honours prefers-reduced-motion. Both layers share one viewBox and
// the same .nl-map__svg box, so they line up exactly.
import mapUrl from "../assets/nl-map.svg?url";
import { DEN_HAAG, NL_VIEWBOX } from "../data/nl-map";
---

<div class="nl-map" aria-hidden="true">
  <div class="nl-map__stage">
    <img class="nl-map__svg" src={mapUrl} alt="" width={NL_VIEWBOX.width} height={NL_VIEWBOX.height} decoding="async" />
    <svg
      class="nl-map__svg"
      viewBox={`0 0 ${NL_VIEWBOX.width} ${NL_VIEWBOX.height}`}
      xmlns="http://www.w3.org/2000/svg"
    >
      <g class="marker" transform={`translate(${DEN_HAAG.x} ${DEN_HAAG.y})`}>
        <circle class="marker__pulse" r="3" />
        <circle class="marker__dot" r="2.6" />
        <path class="marker__leader" d="M-3.6 0 H-17" />
        <text class="marker__label" x="-20" y="2.6" text-anchor="end">Den Haag</text>
      </g>
    </svg>
  </div>
</div>

<style>
  /* Sticky viewport-high stage inside a page-high layer: the map stays in view while scrolling
     but never paints over the navbar or footer. */
  .nl-map {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }
  .nl-map__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .nl-map__svg {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Fit the whole map: limited by viewport height (desktop) and by viewport width (phones). Aspect ratio is 295.8 : 348.4. */
    width: min(94vw, 90vh * 0.849, 730px);
    height: auto;
    transform: translate(-50%, -46%);
    overflow: visible;
  }


  .marker__dot {
    fill: rgb(3 78 162 / 0.85);
  }
  .marker__pulse {
    fill: rgb(3 78 162 / 0.35);
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 3.6s ease-out infinite;
  }
  .marker__leader {
    stroke: rgb(3 78 162 / 0.45);
    stroke-width: 0.6;
    fill: none;
  }
  .marker__label {
    fill: rgb(3 78 162 / 0.75);
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.6; }
    80%, 100% { transform: scale(4.2); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marker__pulse { animation: none; opacity: 0.25; transform: scale(2.2); }
  }
</style>
