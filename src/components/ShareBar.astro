---
// Share an event/post: WhatsApp (how this community shares), copy link, and the phone's native share sheet when the
// browser supports it (button revealed by the global script in Layout.astro). No third-party scripts or trackers.
// Compact on phones: a short label in a fixed column (lines up with AddToCalendar) + equal square icon buttons;
// names live in aria-label/title. The copy button swaps to a check mark for 2 s (data-done, set by the global script).
import { Icon } from "astro-icon/components";
import type { LangOptions } from "../data/i18n";
import { DEFAULT_SITE_URL } from "../data/seo";
import { useTranslations } from "../utils/lang";

interface Props {
  locale: LangOptions;
  title: string;
  class?: string;
}
const { locale, title, class: className } = Astro.props;
const t = useTranslations(locale);
const url = new URL(Astro.url.pathname, Astro.site ?? DEFAULT_SITE_URL).href;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${title}\n${url}`)}`;
const btn =
  "group inline-flex size-11 shrink-0 items-center justify-center rounded-sm border-2 border-brand bg-white text-brand transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-50 focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none";
---

<div class:list={["not-prose flex items-center gap-2", className]} data-pagefind-ignore>
  <span class="sr-only md:not-sr-only text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">{t("share.label")}</span>
  <a href={whatsapp} class={btn} target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
    <img src="/icons/whatsapp.svg" alt="" width="24" height="24" class="size-6" aria-hidden="true" />
  </a>
  <button type="button" class:list={[btn, "max-md:has-[~[data-share]:not([hidden])]:hidden"]} data-copy={url} data-copied={t("share.copied")} aria-label={t("share.copy")} title={t("share.copy")}>
    <Icon name="heroicons:link-solid" class="size-6 group-data-[done]:hidden" aria-hidden="true" />
    <Icon name="heroicons:check-solid" class="hidden size-6 text-brand group-data-[done]:block" aria-hidden="true" />
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </button>
  <button type="button" class={btn} data-share data-title={title} data-url={url} aria-label={t("share.native")} title={t("share.native")} hidden>
    <Icon name="heroicons:share-solid" class="size-6" aria-hidden="true" />
  </button>
</div>
