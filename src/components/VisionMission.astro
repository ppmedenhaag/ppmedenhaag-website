---
interface Props {
    vm?: {
        bg_image?: string;
        vision_title: string;
        mission_title: string;
        vision: string;
        mission: string;
    };
}
const { vm } = Astro.props;
---

{
    vm && (
        <section class="relative isolate overflow-hidden py-14">
            {vm.bg_image && (
                <img
                    src={`/${vm.bg_image}`}
                    alt=""
                    class="absolute inset-0 -z-20 size-full object-cover"
                />
            )}
            <div class="absolute inset-0 -z-10 bg-brand-darker/60" aria-hidden="true"></div>
            <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
                <div class="border border-slate-200 bg-white p-6 sm:p-8">
                    <h2 class="page-title title-rule mb-6 !text-3xl">{vm.vision_title}</h2>
                    <p class="text-justify leading-relaxed text-slate-700" set:html={vm.vision} />
                </div>
                <div class="border border-slate-200 bg-white p-6 sm:p-8">
                    <h2 class="page-title title-rule mb-6 !text-3xl">{vm.mission_title}</h2>
                    <p class="text-justify leading-relaxed text-slate-700" set:html={vm.mission} />
                </div>
            </div>
        </section>
    )
}
