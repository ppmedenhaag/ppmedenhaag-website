---
// "Add to calendar" for an upcoming event: .ics file (Apple Calendar, Outlook, Android calendar apps) + Google Calendar link.
// Rendered only when the event has not ended at build time; the global script in Layout.astro also removes it in the
// browser once `data-expires` has passed, so a stale build never offers a past event.
// Compact on phones: a short label in a fixed column (lines up with ShareBar) + two equal buttons with one-word texts
// that fit one row in nl/id/en; the full description is in aria-label/title.
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import type { LangOptions } from "../data/i18n";
import { DEFAULT_SITE_URL } from "../data/seo";
import { calendarEvent, googleCalendarUrl, icsPath } from "../utils/calendar";
import { eventSlug } from "../utils/event";
import { useTranslations } from "../utils/lang";

interface Props {
  entry: CollectionEntry<"event">;
  locale: LangOptions;
  description?: string;
}
const { entry, locale, description = "" } = Astro.props;
const t = useTranslations(locale);
const url = new URL(Astro.url.pathname, Astro.site ?? DEFAULT_SITE_URL).href;
const cal = calendarEvent(entry, url, description);
const upcoming = cal.end.getTime() > Date.now();
const btn =
  "inline-flex h-11 min-w-0 items-center justify-center gap-1 rounded-sm border-2 border-brand bg-white px-2 text-[13px] font-semibold whitespace-nowrap text-brand transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-50 focus-visible:ring-2 focus-visible:ring-brand focus-visible:outline-none";
---

{
  upcoming && (
    <div class="not-prose flex min-w-0 flex-1 items-center gap-2 md:flex-none lg:w-full lg:flex-col lg:items-stretch lg:gap-1.5" data-expires={cal.end.toISOString()} data-pagefind-ignore>
      <span class="sr-only md:not-sr-only text-xs font-semibold tracking-[0.12em] text-slate-500 uppercase">{t("event.addToCalendar")}</span>
      <div class="grid min-w-0 flex-1 grid-cols-2 gap-2 md:w-72 md:flex-none lg:w-full">
        <a href={icsPath(entry)} download={`${eventSlug(entry)}.ics`} class={btn} aria-label={t("event.icsFile")} title={t("event.icsFile")}>
          <Icon name="heroicons:arrow-down-tray" class="size-4 shrink-0" aria-hidden="true" />
          {t("event.icsShort")}
        </a>
        <a href={googleCalendarUrl(cal)} class={btn} target="_blank" rel="noopener" aria-label={t("event.googleCalendar")} title={t("event.googleCalendar")}>
          <img src="/icons/google-calendar.svg" alt="" width="16" height="16" class="size-4 shrink-0" aria-hidden="true" />
          Google
        </a>
      </div>
    </div>
  )
}
