---
import { render, type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import EventCard from "./EventCard.astro";
import HeroImage from "./HeroImage.astro";
import type { LangOptions } from "../data/i18n";
import { formatDate, formatTime, getLocaleEvents, plainInline } from "../utils/event";
import { useTranslations } from "../utils/lang";
import AddToCalendar from "./AddToCalendar.astro";
import ShareBar from "./ShareBar.astro";
import { mapsUrl } from "../data/site";
import { fullLocation } from "../utils/calendar";
import { getSeoRegistry } from "../utils/seo-registry";

interface Props {
  entry: CollectionEntry<"event">;
  locale: LangOptions;
}
const { entry, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const d = entry.data;
const more = (await getLocaleEvents(locale))
  .filter((e) => e.id !== entry.id)
  .slice(0, 3);
// [icon, label, value, link?] — Heroicons outline via astro-icon. The location links to Google Maps directions.
// On phones (2 columns) location and date take a full row; time + duration share one row (time spans both if no duration).
const hasDuration = !!d.duration && d.duration.trim() !== "...";
const meta = [
  d.location && ["heroicons:map-pin", t("event.location"), plainInline(d.location), mapsUrl(fullLocation(d.location)), "max-sm:col-span-2"],
  ["heroicons:calendar-days", t("event.date"), formatDate(d.date, locale), undefined, "max-sm:col-span-2"],
  ["heroicons:clock", t("event.time"), formatTime(d.date, locale), undefined, hasDuration ? "" : "max-sm:col-span-2"],
  hasDuration && ["tabler:hourglass", t("event.duration"), d.duration, undefined, "max-sm:border-l max-sm:border-slate-200"],
].filter(Boolean) as [string, string, string, string | undefined, string][];
const pageDescription = (await getSeoRegistry()).byPath.get(Astro.url.pathname)?.description ?? "";
---

<Layout title={d.title} date={d.date}>
  <div class="mx-auto max-w-4xl px-2 py-6 sm:px-6 sm:py-10 lg:px-8">
    <article
      class="prose prose-brand lg:prose-lg page-article max-w-none min-w-0 !p-4 sm:!p-6 md:!p-10"
    >
      <header class="mb-8 border-b border-slate-200 pb-8">
        <h1
          class="page-title title-rule mb-8"
        >
          {d.title}
        </h1>
        {
          d.image && (
            <HeroImage
              src={d.image}
              alt={d.title}
              class="w-full border border-slate-200 mb-6"
            />
          )
        }
        <dl class="not-prose grid grid-cols-2 divide-y divide-slate-200 border border-slate-200 bg-brand-50/40 text-sm sm:divide-y-0 md:-mx-10 md:border-x-0 lg:grid-cols-[1.6fr_1.3fr_0.9fr_1fr] lg:divide-x">
          {
            meta.map(([icon, label, value, href, cls]) => (
              <div class:list={["min-w-0 px-3 py-2.5 sm:px-5 sm:py-4", cls]}>
                <dt class="flex items-center gap-2">
                  <Icon name={icon} class="size-5 shrink-0 text-brand" aria-hidden="true" />
                  <span class="eyebrow !text-brand">{label}</span>
                </dt>
                <div class="mt-1.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <dd class="font-medium break-words text-slate-800">{value}</dd>
                  {href && (
                    <dd>
                      <a href={href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-xs font-semibold whitespace-nowrap text-brand hover:text-brand-dark">
                        {t("event.directions")}
                        <Icon name="heroicons:arrow-top-right-on-square" class="size-3.5" aria-hidden="true" />
                      </a>
                    </dd>
                  )}
                </div>
              </div>
            ))
          }
        </dl>
        <div class="mt-4 flex items-center gap-2 md:mt-5 md:flex-wrap md:gap-x-8 md:gap-y-3">
          <AddToCalendar entry={entry} locale={locale} description={pageDescription} />
          <ShareBar locale={locale} title={d.title} />
        </div>
      </header>

      <div
        
      >
        <Content />
      </div>

      {
        d.speaker && d.speaker.length > 0 && (
          <div class="mt-10 border-t border-slate-200 pt-8 not-prose">
            <h2 class="text-lg font-semibold text-slate-900 mb-4">
              {t("event.speakers")}
            </h2>
            <ul class="grid gap-4 sm:grid-cols-2">
              {d.speaker.map((s) => (
                <li class="flex items-center gap-3 text-sm text-slate-700">
                  <img
                    src={`/${s.image}`}
                    alt=""
                    width="48"
                    height="48"
                    class="rounded-full ring-2 ring-brand-100"
                  />
                  <div>
                    <p class="font-semibold">{s.name}</p>
                    {s.designation && (
                      <p class="text-slate-500">{s.designation}</p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </article>

    {
      more.length > 0 && (
        <section class="mt-14" data-pagefind-ignore>
          <h2 class="title-rule mb-8 text-2xl font-bold tracking-tight text-slate-900">
            {t("event.more")}
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {more.map((e) => (
              <EventCard event={e} locale={locale} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
