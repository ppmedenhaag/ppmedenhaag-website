---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { defaultLocale } from "../../data/i18n";

export async function getStaticPaths() {
    const events = await getCollection("event", ({ id, data }) => {
        return id.startsWith(`${defaultLocale}/`) && !data.draft;
    });
    return events.map((entry) => ({
        params: { slug: entry.id.slice(`${defaultLocale}/`.length) },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <article
            class="prose lg:prose-xl mx-auto bg-white p-6 md:p-10 rounded-lg shadow-sm border border-ppme-blue-100"
        >
            <header class="mb-8 border-b border-ppme-blue-100 pb-8">
                <h1
                    class="text-3xl font-bold tracking-tight text-ppme-blue-900 sm:text-4xl mb-4"
                >
                    {entry.data.title}
                </h1>
                <div
                    class="flex flex-wrap items-center gap-4 text-sm text-gray-500"
                >
                    <time datetime={entry.data.date.toISOString()}>
                        {
                            entry.data.date.toLocaleDateString(defaultLocale, {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })
                        }
                    </time>
                    {entry.data.location && <span>{entry.data.location}</span>}
                    {entry.data.duration && <span>{entry.data.duration}</span>}
                </div>
            </header>

            {
                entry.data.image && (
                    <div class="mb-10 overflow-hidden rounded-lg shadow-sm">
                        <img
                            src={`/${entry.data.image}`}
                            alt={entry.data.title}
                            class="w-full object-cover"
                        />
                    </div>
                )
            }

            <div
                class="prose-headings:text-ppme-blue-900 prose-a:text-ppme-blue-600 hover:prose-a:text-ppme-blue-700"
            >
                <Content />
            </div>

            {
                entry.data.speaker && entry.data.speaker.length > 0 && (
                    <div class="mt-10 border-t border-ppme-blue-100 pt-8">
                        <h2 class="text-lg font-semibold text-ppme-blue-900 mb-4">
                            Speakers
                        </h2>
                        <ul class="flex flex-wrap gap-4">
                            {entry.data.speaker.map((s) => (
                                <li class="text-sm text-gray-700">
                                    <span class="font-semibold">{s.name}</span>
                                    {s.designation && <span> — {s.designation}</span>}
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
        </article>
    </div>
</Layout>
