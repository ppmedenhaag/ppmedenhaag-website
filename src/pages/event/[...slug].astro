---
import EventDetail from "../../components/EventDetail.astro";
import { defaultLocale } from "../../data/i18n";
import { getLocaleEvents, eventSlug } from "../../utils/event";

export async function getStaticPaths() {
  const events = await getLocaleEvents(defaultLocale);
  return events.map((entry) => ({
    params: { slug: eventSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<EventDetail entry={entry} locale={defaultLocale} />
