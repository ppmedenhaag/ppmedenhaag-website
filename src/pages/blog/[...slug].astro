---
import PostDetail from "../../components/PostDetail.astro";
import { defaultLocale } from "../../data/i18n";
import { getLocalePosts, postSlug } from "../../utils/blog";

export async function getStaticPaths() {
  const posts = await getLocalePosts(defaultLocale);
  return posts.map((entry) => ({
    params: { slug: postSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<PostDetail entry={entry} locale={defaultLocale} />
