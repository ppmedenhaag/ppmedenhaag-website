---
import HeroImage from "../../components/HeroImage.astro";
import { getEntry, render } from "astro:content";
import VisionMission from "../../components/VisionMission.astro";
import Layout from "../../layouts/Layout.astro";
import { defaultLocale } from "../../data/i18n";

const overview = await getEntry("about-overview", defaultLocale);
if (!overview) {
    throw new Error(`Missing about-overview entry for locale "${defaultLocale}"`);
}
const { Content } = await render(overview);

const homepageEntry = await getEntry(`homepage-${defaultLocale}`, "homepage");
const funfacts = homepageEntry?.data.funfacts;
const visionMission = homepageEntry?.data.vision_mission;
---

<Layout title={overview.data.title}>
    <div class="page-narrow">
        <article
            class="prose prose-brand lg:prose-xl page-article max-w-none min-w-0"
        >
            <h1
                class="page-title title-rule mb-10"
            >
                {overview.data.title}
            </h1>

            {
                overview.data.image && (
                    <div class="not-prose mb-10 overflow-hidden border border-slate-200">
                        <HeroImage
                            src={overview.data.image}
                            alt={overview.data.title}
                            class="block w-full object-cover"
                        />
                    </div>
                )
            }

            <div
                
            >
                <Content />
            </div>
        </article>
    </div>

    {
        funfacts?.enable && (
            <section class="relative isolate overflow-hidden bg-brand-darker py-14">
            <div class="pointer-events-none absolute -top-24 right-0 -z-10 size-80 rounded-full bg-brand/50 blur-3xl" aria-hidden="true"></div>
                <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-4 text-center sm:grid-cols-3">
                    {funfacts.funfact_item.map((item) => (
                        <div>
                            <p class="text-4xl font-bold tracking-tight text-white">
                                {item.count}
                            </p>
                            <p class="eyebrow mt-2 !text-brand-200">{item.name}</p>
                        </div>
                    ))}
                </div>
            </section>
        )
    }

    <VisionMission vm={visionMission} />
</Layout>
