---
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { defaultLocale } from "../../data/i18n";

const overview = await getEntry("about-overview", defaultLocale);
if (!overview) {
    throw new Error(`Missing about-overview entry for locale "${defaultLocale}"`);
}
const { Content } = await render(overview);

const homepageEntry = await getEntry(`homepage-${defaultLocale}`, "homepage");
const funfacts = homepageEntry?.data.funfacts;
---

<Layout title={overview.data.title}>
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <article
            class="prose lg:prose-xl mx-auto bg-white p-6 md:p-10 rounded-lg shadow-sm border border-ppme-blue-100"
        >
            <h1
                class="text-3xl font-bold tracking-tight text-ppme-blue-900 sm:text-4xl mb-8"
            >
                {overview.data.title}
            </h1>

            {
                overview.data.image && (
                    <div class="mb-10 overflow-hidden rounded-lg shadow-sm">
                        <img
                            src={`/${overview.data.image}`}
                            alt={overview.data.title}
                            class="w-full object-cover"
                        />
                    </div>
                )
            }

            <div
                class="prose-headings:text-ppme-blue-900 prose-a:text-ppme-blue-600 hover:prose-a:text-ppme-blue-700"
            >
                <Content />
            </div>
        </article>
    </div>

    {
        funfacts?.enable && (
            <section class="bg-ppme-blue-700 py-12">
                <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-4 text-center sm:grid-cols-3">
                    {funfacts.funfact_item.map((item) => (
                        <div>
                            <p class="text-4xl font-bold text-white">
                                {item.count}
                            </p>
                            <p class="mt-2 text-ppme-blue-100">{item.name}</p>
                        </div>
                    ))}
                </div>
            </section>
        )
    }
</Layout>
