---
import Layout from "../../layouts/Layout.astro";
import Homepage from "../../components/Homepage.astro";
import { locales, defaultLocale, type LangOptions } from "../../data/i18n";

export function getStaticPaths() {
  return Object.keys(locales)
    .filter((lang) => lang !== defaultLocale)
    .map((lang) => ({ params: { locale: lang } }));
}

const { locale } = Astro.params as { locale: LangOptions };
---

<Layout title="PPME Den Haag" searchable={false}>
  <Homepage locale={locale} />
</Layout>
