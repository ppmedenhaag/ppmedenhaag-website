---
import PostDetail from "../../../components/PostDetail.astro";
import { defaultLocale, locales, type LangOptions } from "../../../data/i18n";
import { getLocalePosts, postSlug } from "../../../utils/blog";

export async function getStaticPaths() {
  // Excludes nl: it has its own unprefixed route at src/pages/blog/[...slug].astro.
  // Without this exclusion this route would ALSO generate /nl/blog/... URLs, which
  // the Hugo site never had. See .migration/02-content-migration.md in ppmedenhaag-website.
  const locs = (Object.keys(locales) as LangOptions[]).filter(
    (l) => l !== defaultLocale,
  );
  const all = await Promise.all(locs.map(getLocalePosts));
  return all.flat().map((entry) => ({
    params: { locale: entry.id.split("/")[0], slug: postSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params;
---

<PostDetail entry={entry} locale={locale as LangOptions} />
