---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales, defaultLocale } from "../../../data/i18n";
import { stripMarkdown, truncateText } from "../../../utils/text";

export function getStaticPaths() {
    return Object.keys(locales)
        .filter((lang) => lang !== defaultLocale)
        .map((lang) => ({ params: { locale: lang } }));
}

const { locale } = Astro.params;
const currentLocale = locale ?? defaultLocale;

const events = await getCollection("event", ({ id, data }) => {
    return id.startsWith(`${currentLocale}/`) && !data.draft;
});

const sortedEvents = events.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Events">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <h1
            class="text-3xl font-bold tracking-tight text-ppme-blue-900 sm:text-4xl mb-8"
        >
            Events
        </h1>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {
                sortedEvents.map((event) => (
                    <article class="flex flex-col overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 bg-white border border-gray-100">
                        {event.data.image && (
                            <div class="flex-shrink-0">
                                <img
                                    class="w-full aspect-[4/3] object-cover"
                                    src={`/${event.data.image}`}
                                    alt={event.data.title}
                                />
                            </div>
                        )}
                        <div class="flex flex-1 flex-col justify-between p-6">
                            <div class="flex-1">
                                {event.data.location && (
                                    <p class="text-sm font-medium text-ppme-blue-600">
                                        {event.data.location}
                                    </p>
                                )}
                                <a
                                    href={getRelativeLocaleUrl(
                                        currentLocale,
                                        `event/${event.id.split("/").slice(1).join("/")}`,
                                    )}
                                    class="mt-2 block"
                                >
                                    <p class="text-xl font-semibold text-gray-900">
                                        {event.data.title}
                                    </p>
                                    <p class="mt-3 text-base text-gray-500 line-clamp-3">
                                        {event.data.description ||
                                            truncateText(
                                                stripMarkdown(event.body ?? ""),
                                                100,
                                            )}
                                    </p>
                                </a>
                            </div>
                            <div class="mt-6 flex items-center">
                                <div class="ml-3">
                                    <div class="flex space-x-1 text-sm text-gray-500">
                                        <time datetime={event.data.date.toISOString()}>
                                            {event.data.date.toLocaleDateString(
                                                currentLocale,
                                                {
                                                    year: "numeric",
                                                    month: "long",
                                                    day: "numeric",
                                                },
                                            )}
                                        </time>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</Layout>
