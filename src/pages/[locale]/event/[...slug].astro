---
import EventDetail from "../../../components/EventDetail.astro";
import { defaultLocale, locales, type LangOptions } from "../../../data/i18n";
import { getLocaleEvents, eventSlug } from "../../../utils/event";

export async function getStaticPaths() {
  // Excludes nl — it has its own unprefixed route at src/pages/event/[...slug].astro.
  // Without this exclusion this route would ALSO generate /nl/event/... URLs, which
  // Hugo's site never had. See .migration/02-content-migration.md in ppmedenhaag-website.
  const locs = (Object.keys(locales) as LangOptions[]).filter(
    (l) => l !== defaultLocale,
  );
  const all = await Promise.all(locs.map(getLocaleEvents));
  return all.flat().map((entry) => ({
    params: { locale: entry.id.split("/")[0], slug: eventSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params;
---

<EventDetail entry={entry} locale={locale as LangOptions} />
