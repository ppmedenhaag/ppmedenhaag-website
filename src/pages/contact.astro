---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/contact-form.astro";
---

<Layout searchable={false}>
  <div class="section">
    <ContactForm />
  </div>
</Layout>

<script>
  window.onbeforeunload = () => {
    for (const form of document.getElementsByTagName("form")) {
      form.reset();
    }
  };
</script>
